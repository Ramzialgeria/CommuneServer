  </runtime>
	<entityFramework>
		<providers>
			<provider invariantName="Npgsql" type="Npgsql.NpgsqlServices, EntityFramework6.Npgsql, Version=6.4.3.0, Culture=neutral, PublicKeyToken=5d8b90d52f46fda7" />
		</providers>

		<defaultConnectionFactory type="Npgsql.NpgsqlConnectionFactory, EntityFramework6.Npgsql, Version=6.4.3.0, Culture=neutral, PublicKeyToken=5d8b90d52f46fda7" />
	</entityFramework>
  <connectionStrings>
    <add name="CommuneDb" connectionString="Host=127.0.0.1;Port=5432;Database=commune_0101;Username=postgres;Password=123456" providerName="Npgsql" />
  </connectionStrings>
  <appSettings>
    <!-- Commune identification -->
    <add key="CommuneCode" value="0621" />
    <add key="ServerCode" value="COMMUNE-0621" />
    <!-- Central authentication -->
    <add key="ClientSecret" value="Client1234!" />
    <!-- Central ASP.NET Core API -->
    <add key="CentralApiUrl" value="http://localhost:5000/" />
    <!-- Heartbeat -->
    <add key="HeartbeatSeconds" value="30" />
    <!-- Local API used by Clients -->
    <add key="LocalApiIp" value="192.168.1.35" />
    <add key="LocalApiPort" value="5050" />

	  <add key="JwtSecret" value="CommuneServer-Jwt-Secret-2026-Long-Random-Key-9f72a81c" />

	  <add key="JwtIssuer" value="CommuneServer" />

	  <add key="JwtAudience" value="CommuneClients" />
  </appSettings>
  <system.data>
    <DbProviderFactories>
      <remove invariant="Npgsql" />
      <add name="Npgsql Provider" invariant="Npgsql" description=".NET Framework Data Provider for PostgreSQL" type="Npgsql.NpgsqlFactory, Npgsql, Version=4.1.13.0, Culture=neutral, PublicKeyToken=5d8b90d52f46fda7" />
    </DbProviderFactories>
  </system.data>
